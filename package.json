{
  "name": "named-links",
  "version": "101.3.304",
  "description": "Fetch the title of a pasted or dropped URL and insert it as a markdown link.",
  "main": "main.js",
  "scripts": {
    "dev": "node config/esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node config/esbuild.config.mjs production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test config scripts eslint.config.mts",
    "lint:fix": "eslint src test config scripts eslint.config.mts --fix",
    "prettier": "prettier --ignore-path config/.prettierignore --write \"./src/**/*.ts\" \"./test/**/*.ts\"",
    "clean": "npm run prettier && npm run lint:fix",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "mocha --import=tsx \"test/unit/**/*.test.ts\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "scripts/xvfb-wm.sh wdio run ./config/wdio.conf.mts",
    "prescreenshots": "npm run build",
    "screenshots": "scripts/xvfb-wm.sh wdio run ./config/wdio.screenshots.mts",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "links",
    "markdown"
  ],
  "author": "danyim",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "linkedom": "^0.18.13",
    "mocha": "^10.8.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.9",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css",
    "bracketSameLine": false,
    "printWidth": 80,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "importOrder": [
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  },
  "overrides": {
    "@codemirror/commands": {
      "@codemirror/state": "$@codemirror/state"
    }
  }
}
